# ---------------------------------------------------------------------------
# ConnectSphere environment configuration (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Uses Supabase's newer publishable/secret API keys (Settings > API Keys in
# the dashboard), not the legacy anon/service_role JWT keys — Supabase is
# retiring the legacy keys; the new ones are drop-in compatible. See
# docs/SETUP.md for details.
# ---------------------------------------------------------------------------

# --- Supabase project (vuiryrzzyfecjqftwicj) -------------------------------
SUPABASE_URL=https://vuiryrzzyfecjqftwicj.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here
# No JWT secret needed — session tokens are verified via the Supabase SDK's
# get_claims(), which checks the project's published JWKS. See docs/SETUP.md.

# --- Backend (FastAPI) ------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# --- Frontend (Vite) ---------------------------------------------------------
VITE_SUPABASE_URL=https://vuiryrzzyfecjqftwicj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_API_BASE_URL=http://localhost:8000/api/v1

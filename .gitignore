# Environment
.env
.env.local

# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# Supabase CLI local state, in any folder the CLI was run from. `supabase start`
# writes the local stack's service-role key and JWT secret under
# .temp/start-secrets/, which GitGuardian flagged in PR #4.
**/supabase/.temp/
**/supabase/.branches/

# Editors / OS
.vscode/
.DS_Store
Thumbs.db

# Reusable Claude Code prompts/commands (local workflow aids, not project deliverables)
.claude/
docs/prompts/
CLAUDE.md

# Tooling / MCP artifacts
.playwright-mcp/

# Customer Q&A exports kept locally for reference; REQUIREMENTS.md cites them as QA-<row> / QA2-<n>
docs/Session * - Clarification Answers*

# Playwright output (failure screenshots and traces); run logs go to docs/test-cases/runs/
frontend/test-results/
frontend/playwright-report/

# JUnit reports written by the CI test steps
backend/reports/
frontend/reports/

# Coverage data and reports (docs/CI.md §4 item 2)
backend/.coverage
backend/htmlcov/
frontend/coverage/

# Mutation testing working copies and reports (docs/MUTATION_TESTING.md)
backend/mutants/
frontend/reports/mutation/
frontend/.stryker-tmp/
